+                    "Unknown action: \"$action\" (expected deny/allow/reset). " +
+                        "Currently visible: ${visibleToolNames()}", false
+                )
+            }
+        } catch (e: Exception) {
+            ToolExecutionResult("modify_tools failed: ${e.message}", false)
+        }
+    }
