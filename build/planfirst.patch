+     * exists — the AI cannot lock itself out.
+     */
+    private fun executeModifyTools(argsJson: String): ToolExecutionResult {
+        return try {
+            val obj = JSONObject(argsJson)
+            val action = obj.optString("action", "").trim().lowercase()
+            val rawNames = obj.optString("tools", "")
+            val names = rawNames.split(',').map { it.trim() }.filter { it.isNotEmpty() }
+            when (action) {
+                "deny" -> {
+                    names.forEach { toolDenyList.add(it) }
+                    ToolExecutionResult(
+                        "Hidden tools: ${names.joinToString(", ")}. " +
+                            "Currently visible: ${visibleToolNames()}", true
+                    )
+                }
+                "allow" -> {
+                    names.forEach { toolDenyList.remove(it) }
+                    ToolExecutionResult(
+                        "Restored tools: ${names.joinToString(", ")}. " +
+                            "Currently visible: ${visibleToolNames()}", true
+                    )
+                }
+                "reset" -> {
+                    toolDenyList.clear()
+                    ToolExecutionResult("Restored all tools. Visible: ${visibleToolNames()}", true)
+                }
